<?xml version="1.0" encoding="utf-8"?>
<!-- [Thành viên 1: Quản trị Lưu trữ và Trích xuất dữ liệu] -->
<!-- Cấu hình các đường dẫn lưu tệp xuất ra phục vụ chia sẻ an toàn qua FileProvider -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Thư mục cache nội bộ lưu tệp xuất tạm thời -->
    <cache-path name="exports_cache" path="exports/" />
    <!-- Thư mục tệp nội bộ của ứng dụng -->
    <files-path name="exports_files" path="exports/" />
    <!-- Thư mục tệp ngoại vi của ứng dụng -->
    <external-files-path name="exports_external" path="exports/" />
</paths>
